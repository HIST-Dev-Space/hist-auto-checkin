DATABASE_URL=postgres://hist:CHANGE_ME@127.0.0.1:35432/hist
POSTGRES_PASSWORD=CHANGE_ME
# 32 random bytes, standard base64; scripts/init-env.py generates both secrets.
CREDENTIAL_KEY_BASE64=
BIND_ADDR=0.0.0.0:38080
ALLOW_REGISTRATION=true
AUTH_RATE_LIMIT_PER_IP=120
# Comma-separated CIDRs. Only these proxies may supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
WORKER_CONCURRENCY=4
WEIXIN_POLL_CONCURRENCY=32
DATABASE_MAX_CONNECTIONS=20
# Required: school check-in service URL (HTTPS).
SCHOOL_BASE_URL=
# Required: school authentication service URL (HTTPS).
SCHOOL_LOGIN_BASE_URL=
# Optional school-only outbound proxy. socks5h resolves upstream DNS at the proxy.
SCHOOL_PROXY_URL=
# Set true when the public site is served over HTTPS.
COOKIE_SECURE=false
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_CHANNEL_VERSION=2.4.9
RUST_LOG=hist_auto_ckeckin=info,tower_http=info
